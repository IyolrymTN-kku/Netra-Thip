# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# user-uploaded scan inputs (Cat 3 tools)
/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#n8n-workflow
Netra-Thip_ Core Engine-lastest-V3.json

# ─── Netra-Thip safety baseline ───
# Local SSH keys / private keys (never commit runner credentials)
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
**/.ssh/

# n8n exported workflows MAY contain live API keys, HMAC secrets, SSH creds.
# Keep raw exports out of git; only the sanitized reference copy is tracked.
/n8n-*.json
*Core Engine*.json
/orchestration/n8n/*.json
!/orchestration/n8n/workflow.sanitized.json

# Security-tool reports / logs / scratch — never commit scan output
/runners/**/reports/
/runners/**/logs/
AutopentestX/**/reports/*.json
AutopentestX/**/logs/*.json
**/guardian*/**/reports/
**/guardian*/**/session_*.json
**/vuls*/**/results/
**/vuls*/**/tmp/
*.scan.json
