# Local development environment — DO NOT commit real secrets.
# Matches docker-compose.yml services.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adeo_portal?schema=public"
MONGODB_URI="mongodb://admin:password@localhost:27017/adeo_portal?authSource=admin"

NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# 64 hex chars = 32 bytes. Replace before any non-dev use.
ENCRYPTION_KEY=

ADMIN_EMAIL="admin@netra-thip.local"
ADMIN_PASSWORD=

N8N_WEBHOOK_URL="http://localhost:5678/webhook/scan-trigger"

# HMAC secret for trigger->callback authentication. Replace before any non-dev use.
N8N_CALLBACK_SECRET=

UPLOAD_DIR="./uploads"
