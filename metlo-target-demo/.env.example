# Address reachable from the machine that runs this target app.
METLO_HOST=http://10.170.100.142:8081

# Create or copy a valid Metlo collector API key. Do not commit the real key.
METLO_API_KEY=metlo.replace-with-your-key

# Use a new app port so it does not collide with an existing demo target.
APP_HOST=0.0.0.0
APP_PORT=6010

# Prevent collector calls being redirected through an HTTP proxy.
NO_PROXY=10.170.100.142,localhost,127.0.0.1
no_proxy=10.170.100.142,localhost,127.0.0.1
